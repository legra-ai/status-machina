from collections.abc import Callable

class NativeFailure(Exception): ...
class _Definition:
    def __init__(self, source: str) -> None: ...
    def label_inventory(self) -> str: ...
    def structural_coverage(self, entries: int, bytes: int) -> str: ...
    def diagram(self, labels: str, entries: int, bytes: int) -> str: ...
    def instantiate(self, initial: int, capacity: int, invoker: Callable[[str], str]) -> _Instance: ...
class _Instance:
    def arena_id(self) -> str: ...
    def live_keys(self) -> list[int]: ...
    def state(self) -> int: ...
    def revision(self) -> int: ...
    def snapshot(self, invoker: Callable[[str], str]) -> str: ...
    def dispatch(self, kind: int, payload: int, facts: int, invoker: Callable[[str], str], revision: int | None = None) -> str: ...
    def evaluate(self, kind: int, payload: int, facts: int, invoker: Callable[[str], str], revision: int | None = None) -> _Decision: ...
    def evaluate_capability(self, id: int, facts: int, invoker: Callable[[str], str]) -> str: ...
    def accept(self, decision: _Decision) -> str: ...
    def dispose(self) -> None: ...
class _Decision:
    def expected_revision(self) -> int: ...
    def dispose(self) -> None: ...
