from collections.abc import Callable

class NativeFailure(Exception): ...
class _Definition:
    def __init__(self, source: str) -> None: ...
    @staticmethod
    def bind_record(source: str) -> _Definition: ...
    def label_inventory(self) -> str: ...
    def structural_coverage(self, entries: int, bytes: int) -> str: ...
    def diagram(self, labels: str, entries: int, bytes: int) -> str: ...
    def instantiate(self, initial: int, capacity: int, invoker: Callable[[str], str]) -> _Instance: ...
    def replay(self, arena: _Arena, source: str, invoker: Callable[[str], str]) -> str: ...
class _Instance:
    def arena_id(self) -> str: ...
    def live_keys(self) -> list[int]: ...
    def state(self) -> int: ...
    def revision(self) -> int: ...
    def snapshot(self, invoker: Callable[[str], str]) -> str: ...
    def dispatch(self, kind: int, payload: int, facts: int, invoker: Callable[[str], str], revision: int | None = None) -> str: ...
    def evaluate(self, kind: int, payload: int, facts: int, invoker: Callable[[str], str], revision: int | None = None) -> _Decision: ...
    def evaluate_capability(self, id: int, facts: int, invoker: Callable[[str], str]) -> tuple[str, _CapabilityReport]: ...
    def accept(self, decision: _Decision) -> str: ...
    def dispose(self) -> None: ...
class _Decision:
    def expected_revision(self) -> int: ...
    def dispose(self) -> None: ...
class _IdentityMap:
    def __init__(self, pairs: list[tuple[int, int]], max_entries: int) -> None: ...
    def encode(self, identity: int) -> int: ...
    def decode(self, representation: int) -> int: ...
class _Arena:
    def __init__(self, capacity: int) -> None: ...
    def arena_id(self) -> str: ...
    def live_keys(self) -> list[int]: ...
class _CapabilityReport: ...
class _CapabilitySnapshot: ...
class _Composition:
    def __init__(self, source: str, machines: list[_Instance]) -> None: ...
    def route_batch(self, arena: _Arena, source: str, snapshot: _CapabilitySnapshot | None = None) -> str: ...
    def snapshot(self, source: str, reports: list[_CapabilityReport]) -> _CapabilitySnapshot: ...
    def bind(self, source: str, machines: list[_Instance]) -> None: ...
    def propagate(self, arena: _Arena, source: str, machines: list[_Instance],
        invokers: list[Callable[[str], str]], snapshot: _CapabilitySnapshot | None = None) -> tuple[str, NativeFailure | None]: ...
def propagation_limits(steps: int | None, intents: int | None) -> None: ...
class _RetryPolicy:
    def __init__(self, source: str) -> None: ...
    def schedule(self, source: str) -> str: ...
class _RetryWaits:
    def __init__(self, capacity: int | None = None) -> None: ...
    def clone(self) -> _RetryWaits: ...
    def schedule(self, source: str) -> str: ...
    def pending(self) -> str: ...
    def get(self, operation: int | None) -> str: ...
    def mark_registered(self, source: str) -> bool: ...
    def is_due(self, source: str) -> bool: ...
    def consume(self, source: str) -> str: ...
    def cancel(self, operation: int | None) -> str: ...
def scenario_limits(source: str) -> str: ...
def scenario_set(source: str) -> None: ...
def scenario_assertion(has_predicate: bool) -> None: ...
